# ---------------------------------------------------------------------------
# Xray Panel — environment template. Copy to .env and fill real values.
# The backend FAILS TO START if a required variable is missing (no defaults
# are invented for secrets). Never commit the real .env.
# ---------------------------------------------------------------------------

# 32-byte master key for AES-256-GCM at-rest encryption (base64-encoded).
# Generate: openssl rand -base64 32
PANEL_ENCRYPTION_KEY=

# Secret used to sign JWT access/refresh tokens.
# Generate: openssl rand -base64 48
PANEL_JWT_SECRET=

# Initial admin, seeded on first start only (password is bcrypt-hashed at rest).
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=

# Public domain the panel is served on (used by Caddy for TLS and as the
# default base URL for subscription links). Local dev may use localhost.
PANEL_DOMAIN=localhost

# SQLite database file path (inside the container/volume).
DB_PATH=/data/panel.db

# HTTP listen address for the Go backend (behind Caddy).
PANEL_HTTP_ADDR=:8080

# Optional: base URL used when building subscription links, if different from
# https://PANEL_DOMAIN (e.g. behind a custom path). Leave empty to derive it.
PANEL_SUB_BASE_URL=
